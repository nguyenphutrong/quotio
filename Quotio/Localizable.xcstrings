    "settings.yubikey.title" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "YubiKey secret vault" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Coffre de secrets YubiKey" } }, "vi" : { "stringUnit" : { "state" : "translated", "value" : "Két bảo mật YubiKey" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "YubiKey 密钥保险库" } } } },
    "settings.yubikey.help" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Uses an RSA PIV identity on your YubiKey. Quotio stores encrypted ciphertext locally; the private key and PIN stay on the YubiKey. Set up a key below if none is listed." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Utilise une identité PIV RSA sur votre YubiKey. Quotio stocke localement du texte chiffré ; la clé privée et le code PIN restent sur la YubiKey. Configurez une clé ci-dessous si aucune n’apparaît." } }, "vi" : { "stringUnit" : { "state" : "translated", "value" : "Sử dụng danh tính PIV RSA trên YubiKey của bạn. Quotio lưu bản mã hóa trên máy; khóa riêng và mã PIN luôn nằm trong YubiKey. Hãy thiết lập một khóa bên dưới nếu chưa có khóa nào." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "使用 YubiKey 上的 RSA PIV 身份。Quotio 在本地保存加密后的密文；私钥和 PIN 始终留在 YubiKey 上。如果下方没有列出密钥，请先设置一个。" } } } },
    "settings.yubikey.detected" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "YubiKey detected. Set it up to use it as Quotio’s secret vault." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "YubiKey détectée. Configurez-la pour l’utiliser comme coffre de secrets de Quotio." } }, "vi" : { "stringUnit" : { "state" : "translated", "value" : "Đã phát hiện YubiKey. Hãy thiết lập để dùng làm két bảo mật của Quotio." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "已检测到 YubiKey。完成设置后即可用作 Quotio 的密钥保险库。" } } } },
    "settings.yubikey.insert" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Insert a YubiKey to use it as Quotio’s secret vault." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Insérez une YubiKey pour l’utiliser comme coffre de secrets de Quotio." } }, "vi" : { "stringUnit" : { "state" : "translated", "value" : "Hãy cắm YubiKey để dùng làm két bảo mật của Quotio." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "请插入 YubiKey，以将其用作 Quotio 的密钥保险库。" } } } },
    "settings.yubikey.setupPicker" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "YubiKey to set up" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "YubiKey à configurer" } }, "vi" : { "stringUnit" : { "state" : "translated", "value" : "YubiKey cần thiết lập" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "要设置的 YubiKey" } } } },
    "settings.yubikey.setup" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Set up this YubiKey…" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Configurer cette YubiKey…" } }, "vi" : { "stringUnit" : { "state" : "translated", "value" : "Thiết lập YubiKey này…" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "设置此 YubiKey…" } } } },
    "settings.yubikey.identityPicker" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "YubiKey PIV key" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Clé PIV YubiKey" } }, "vi" : { "stringUnit" : { "state" : "translated", "value" : "Khóa PIV YubiKey" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "YubiKey PIV 密钥" } } } },
    "settings.yubikey.change" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Change associated key" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Changer la clé associée" } }, "vi" : { "stringUnit" : { "state" : "translated", "value" : "Đổi khóa liên kết" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "更改关联的密钥" } } } },
    "settings.yubikey.use" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Use this YubiKey" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Utiliser cette YubiKey" } }, "vi" : { "stringUnit" : { "state" : "translated", "value" : "Dùng YubiKey này" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "使用此 YubiKey" } } } },
    "settings.yubikey.selected" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "New Quotio secrets will be encrypted for this YubiKey. Existing Quotio secrets migrate when next used." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Les nouveaux secrets Quotio seront chiffrés pour cette YubiKey. Les secrets existants migreront à leur prochaine utilisation." } }, "vi" : { "stringUnit" : { "state" : "translated", "value" : "Các bí mật mới của Quotio sẽ được mã hóa cho YubiKey này. Các bí mật hiện có sẽ được chuyển sang khi dùng lần tới." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "新的 Quotio 密钥将为此 YubiKey 加密。现有的 Quotio 密钥会在下次使用时迁移。" } } } },
    "settings.yubikey.changeBlocked" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The current YubiKey cannot be changed while it protects Quotio secrets." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "La YubiKey actuelle ne peut pas être changée tant qu’elle protège des secrets Quotio." } }, "vi" : { "stringUnit" : { "state" : "translated", "value" : "Không thể đổi YubiKey hiện tại khi nó đang bảo vệ các bí mật của Quotio." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "当前 YubiKey 正在保护 Quotio 密钥时无法更换。" } } } },
    "settings.yubikey.refresh" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Refresh YubiKeys" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Actualiser les YubiKeys" } }, "vi" : { "stringUnit" : { "state" : "translated", "value" : "Làm mới danh sách YubiKey" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "刷新 YubiKey" } } } },
    "settings.yubikey.status.inactive" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Not configured. Quotio secrets are stored in the macOS Keychain." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Non configuré. Les secrets Quotio sont stockés dans le trousseau macOS." } }, "vi" : { "stringUnit" : { "state" : "translated", "value" : "Chưa thiết lập. Các bí mật của Quotio được lưu trong Keychain của macOS." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "尚未配置。Quotio 密钥保存在 macOS 钥匙串中。" } } } },
    "settings.yubikey.status.active" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Active — %@" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Actif — %@" } }, "vi" : { "stringUnit" : { "state" : "translated", "value" : "Đang hoạt động — %@" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "已启用 — %@" } } } },
    "settings.yubikey.status.activeDetail" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Key %1$@ · %2$lld secrets protected" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Clé %1$@ · %2$lld secrets protégés" } }, "vi" : { "stringUnit" : { "state" : "translated", "value" : "Khóa %1$@ · %2$lld bí mật được bảo vệ" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "密钥 %1$@ · 已保护 %2$lld 个密钥" } } } },
    "settings.yubikey.status.missing" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Configured YubiKey is not connected" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "La YubiKey configurée n’est pas connectée" } }, "vi" : { "stringUnit" : { "state" : "translated", "value" : "YubiKey đã cấu hình chưa được kết nối" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "已配置的 YubiKey 未连接" } } } },
    "settings.yubikey.status.missingDetail" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Insert key %1$@ to unlock %2$lld protected secrets." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Insérez la clé %1$@ pour déverrouiller %2$lld secrets protégés." } }, "vi" : { "stringUnit" : { "state" : "translated", "value" : "Hãy cắm khóa %1$@ để mở %2$lld bí mật được bảo vệ." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "请插入密钥 %1$@ 以解锁 %2$lld 个受保护的密钥。" } } } },
    "settings.yubikey.setupSucceeded" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "YubiKey set up. Quotio secrets are now protected by this key." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "YubiKey configurée. Les secrets Quotio sont désormais protégés par cette clé." } }, "vi" : { "stringUnit" : { "state" : "translated", "value" : "Đã thiết lập YubiKey. Các bí mật của Quotio hiện được khóa này bảo vệ." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "YubiKey 设置完成。Quotio 密钥现在由该密钥保护。" } } } },
    "settings.yubikey.setupSucceededSelect" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "YubiKey set up. Choose the key below to start protecting Quotio secrets." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "YubiKey configurée. Choisissez la clé ci-dessous pour protéger les secrets Quotio." } }, "vi" : { "stringUnit" : { "state" : "translated", "value" : "Đã thiết lập YubiKey. Hãy chọn khóa bên dưới để bắt đầu bảo vệ các bí mật của Quotio." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "YubiKey 设置完成。请在下方选择该密钥以开始保护 Quotio 密钥。" } } } },
    "yubikey.setup.title" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Set up YubiKey" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Configurer la YubiKey" } }, "vi" : { "stringUnit" : { "state" : "translated", "value" : "Thiết lập YubiKey" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "设置 YubiKey" } } } },
    "yubikey.setup.inspecting" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Checking the PIV state on this YubiKey…" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Vérification de l’état PIV de cette YubiKey…" } }, "vi" : { "stringUnit" : { "state" : "translated", "value" : "Đang kiểm tra trạng thái PIV của YubiKey này…" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "正在检查此 YubiKey 的 PIV 状态…" } } } },
    "yubikey.setup.plan" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Quotio will create an RSA-2048 key and certificate in PIV slot 9d, and replace the PIV management key with a new one protected by your PIN." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Quotio va créer une clé et un certificat RSA-2048 dans l’emplacement PIV 9d, et remplacer la clé de gestion PIV par une nouvelle clé protégée par votre code PIN." } }, "vi" : { "stringUnit" : { "state" : "translated", "value" : "Quotio sẽ tạo khóa và chứng chỉ RSA-2048 trong khe PIV 9d, đồng thời thay khóa quản trị PIV bằng khóa mới được bảo vệ bằng mã PIN của bạn." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "Quotio 将在 PIV 插槽 9d 中创建 RSA-2048 密钥和证书，并将 PIV 管理密钥替换为受 PIN 保护的新密钥。" } } } },
    "yubikey.setup.slotOccupied" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Slot 9d already holds a key or certificate. It will be destroyed and cannot be recovered." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "L’emplacement 9d contient déjà une clé ou un certificat. Son contenu sera détruit et irrécupérable." } }, "vi" : { "stringUnit" : { "state" : "translated", "value" : "Khe 9d đã chứa khóa hoặc chứng chỉ. Nội dung đó sẽ bị hủy và không thể khôi phục." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "插槽 9d 中已存在密钥或证书。其内容将被销毁且无法恢复。" } } } },
    "yubikey.setup.slotUnknown" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "This YubiKey cannot report what slot 9d holds. Assume anything stored there will be destroyed." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Cette YubiKey ne peut pas indiquer le contenu de l’emplacement 9d. Considérez que tout ce qui s’y trouve sera détruit." } }, "vi" : { "stringUnit" : { "state" : "translated", "value" : "YubiKey này không thể cho biết khe 9d đang chứa gì. Hãy xem như mọi thứ trong đó sẽ bị hủy." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "此 YubiKey 无法报告插槽 9d 的内容。请假定其中的所有内容都将被销毁。" } } } },
    "yubikey.setup.slotEmpty" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Slot 9d is empty." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "L’emplacement 9d est vide." } }, "vi" : { "stringUnit" : { "state" : "translated", "value" : "Khe 9d đang trống." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "插槽 9d 为空。" } } } },
    "yubikey.setup.managementKeyNote" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The current PIV management key will be replaced. Other PIV tools configured with it will stop working." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "La clé de gestion PIV actuelle sera remplacée. Les autres outils PIV configurés avec elle cesseront de fonctionner." } }, "vi" : { "stringUnit" : { "state" : "translated", "value" : "Khóa quản trị PIV hiện tại sẽ bị thay thế. Các công cụ PIV khác đang dùng khóa đó sẽ ngừng hoạt động." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "当前的 PIV 管理密钥将被替换。使用该密钥配置的其他 PIV 工具将无法继续工作。" } } } },
    "yubikey.setup.pin" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "YubiKey PIN" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Code PIN YubiKey" } }, "vi" : { "stringUnit" : { "state" : "translated", "value" : "Mã PIN YubiKey" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "YubiKey PIN" } } } },
    "yubikey.setup.pinPlaceholder" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "PIV PIN" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Code PIN PIV" } }, "vi" : { "stringUnit" : { "state" : "translated", "value" : "Mã PIN PIV" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "PIV PIN" } } } },
    "yubikey.setup.pinTries" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "%@ PIN attempts remaining" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "%@ tentatives de PIN restantes" } }, "vi" : { "stringUnit" : { "state" : "translated", "value" : "Còn %@ lần thử mã PIN" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "剩余 PIN 尝试次数：%@" } } } },
    "yubikey.setup.pinNote" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The PIN is passed straight to ykman and is never stored by Quotio." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Le code PIN est transmis directement à ykman et n’est jamais stocké par Quotio." } }, "vi" : { "stringUnit" : { "state" : "translated", "value" : "Mã PIN được chuyển thẳng tới ykman và không bao giờ được Quotio lưu lại." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "PIN 会直接传给 ykman，Quotio 绝不保存。" } } } },
    "yubikey.setup.managementKey" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Current management key (optional)" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Clé de gestion actuelle (facultatif)" } }, "vi" : { "stringUnit" : { "state" : "translated", "value" : "Khóa quản trị hiện tại (tùy chọn)" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "当前管理密钥（可选）" } } } },
    "yubikey.setup.managementKeyPlaceholder" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Leave empty to use the default key" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Laisser vide pour utiliser la clé par défaut" } }, "vi" : { "stringUnit" : { "state" : "translated", "value" : "Để trống để dùng khóa mặc định" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "留空以使用默认密钥" } } } },
    "yubikey.setup.acknowledge" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "I understand that slot 9d and the management key will be replaced permanently." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Je comprends que l’emplacement 9d et la clé de gestion seront remplacés définitivement." } }, "vi" : { "stringUnit" : { "state" : "translated", "value" : "Tôi hiểu rằng khe 9d và khóa quản trị sẽ bị thay thế vĩnh viễn." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "我了解插槽 9d 和管理密钥将被永久替换。" } } } },
    "yubikey.setup.start" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Set up YubiKey" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Configurer la YubiKey" } }, "vi" : { "stringUnit" : { "state" : "translated", "value" : "Thiết lập YubiKey" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "设置 YubiKey" } } } },
    "yubikey.setup.working" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Setting up… touch the YubiKey if it blinks." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Configuration… touchez la YubiKey si elle clignote." } }, "vi" : { "stringUnit" : { "state" : "translated", "value" : "Đang thiết lập… hãy chạm vào YubiKey nếu nó nhấp nháy." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "正在设置…如果 YubiKey 闪烁，请触摸它。" } } } },
    "yubikey.error.toolMissing" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "ykman was not found. Install the YubiKey Manager CLI (brew install ykman) and try again." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "ykman est introuvable. Installez l’outil YubiKey Manager (brew install ykman) puis réessayez." } }, "vi" : { "stringUnit" : { "state" : "translated", "value" : "Không tìm thấy ykman. Hãy cài YubiKey Manager CLI (brew install ykman) rồi thử lại." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "未找到 ykman。请安装 YubiKey Manager 命令行工具（brew install ykman）后重试。" } } } },
    "yubikey.error.timedOut" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The YubiKey did not respond in time. Reconnect it and try again." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "La YubiKey n’a pas répondu à temps. Reconnectez-la et réessayez." } }, "vi" : { "stringUnit" : { "state" : "translated", "value" : "YubiKey không phản hồi kịp. Hãy cắm lại và thử lần nữa." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "YubiKey 未及时响应。请重新连接后重试。" } } } },
    "yubikey.error.deviceUnavailable" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Could not read the YubiKey: %@" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Impossible de lire la YubiKey : %@" } }, "vi" : { "stringUnit" : { "state" : "translated", "value" : "Không đọc được YubiKey: %@" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "无法读取 YubiKey：%@" } } } },
    "yubikey.error.managementKey" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The management key was rejected. Enter the current management key and try again." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "La clé de gestion a été refusée. Saisissez la clé de gestion actuelle et réessayez." } }, "vi" : { "stringUnit" : { "state" : "translated", "value" : "Khóa quản trị bị từ chối. Hãy nhập khóa quản trị hiện tại rồi thử lại." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "管理密钥被拒绝。请输入当前的管理密钥后重试。" } } } },
    "yubikey.error.pin" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The PIN was rejected." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Le code PIN a été refusé." } }, "vi" : { "stringUnit" : { "state" : "translated", "value" : "Mã PIN bị từ chối." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "PIN 被拒绝。" } } } },
    "yubikey.error.pinTries" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The PIN was rejected. %lld attempts remaining." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Le code PIN a été refusé. %lld tentatives restantes." } }, "vi" : { "stringUnit" : { "state" : "translated", "value" : "Mã PIN bị từ chối. Còn %lld lần thử." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "PIN 被拒绝。剩余 %lld 次尝试。" } } } },
    "yubikey.error.pinBlocked" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The PIN is blocked. Unblock it with the PUK before setting up this key." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Le code PIN est bloqué. Débloquez-le avec le PUK avant de configurer cette clé." } }, "vi" : { "stringUnit" : { "state" : "translated", "value" : "Mã PIN đã bị khóa. Hãy mở khóa bằng PUK trước khi thiết lập khóa này." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "PIN 已被锁定。请先用 PUK 解锁，然后再设置此密钥。" } } } },
    "yubikey.error.step" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "YubiKey setup failed: %@" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Échec de la configuration de la YubiKey : %@" } }, "vi" : { "stringUnit" : { "state" : "translated", "value" : "Thiết lập YubiKey thất bại: %@" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "YubiKey 设置失败：%@" } } } },
    "settings.yubikey.setupUnpublished" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "YubiKey set up, but macOS has not published the new key yet. Reconnect the YubiKey, then refresh." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "YubiKey configurée, mais macOS n’a pas encore publié la nouvelle clé. Reconnectez la YubiKey, puis actualisez." } }, "vi" : { "stringUnit" : { "state" : "translated", "value" : "Đã thiết lập YubiKey, nhưng macOS chưa công bố khóa mới. Hãy cắm lại YubiKey rồi làm mới." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "YubiKey 设置完成，但 macOS 尚未发布新密钥。请重新连接 YubiKey，然后刷新。" } } } },
    "settings.yubikey.setupUnusedKeyConfigured" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "YubiKey set up. It stays unused while another key protects Quotio secrets." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "YubiKey configurée. Elle reste inutilisée tant qu’une autre clé protège les secrets Quotio." } }, "vi" : { "stringUnit" : { "state" : "translated", "value" : "Đã thiết lập YubiKey. Khóa này chưa được dùng khi một khóa khác đang bảo vệ các bí mật của Quotio." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "YubiKey 设置完成。在另一把密钥保护 Quotio 密钥期间，它将保持未使用状态。" } } } },
