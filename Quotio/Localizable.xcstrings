    "agents.claude.removeProxyManually" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "To revert to default, remove these environment variables from ~/.claude/settings.json:\n- ANTHROPIC_BASE_URL\n- ANTHROPIC_AUTH_TOKEN\n- ANTHROPIC_DEFAULT_OPUS_MODEL\n- ANTHROPIC_DEFAULT_SONNET_MODEL\n- ANTHROPIC_DEFAULT_HAIKU_MODEL" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Pour rétablir la configuration par défaut, supprimez ces variables d’environnement de ~/.claude/settings.json :\n- ANTHROPIC_BASE_URL\n- ANTHROPIC_AUTH_TOKEN\n- ANTHROPIC_DEFAULT_OPUS_MODEL\n- ANTHROPIC_DEFAULT_SONNET_MODEL\n- ANTHROPIC_DEFAULT_HAIKU_MODEL" } }, "vi" : { "stringUnit" : { "state" : "translated", "value" : "Để khôi phục mặc định, hãy xóa các biến môi trường này khỏi ~/.claude/settings.json:\n- ANTHROPIC_BASE_URL\n- ANTHROPIC_AUTH_TOKEN\n- ANTHROPIC_DEFAULT_OPUS_MODEL\n- ANTHROPIC_DEFAULT_SONNET_MODEL\n- ANTHROPIC_DEFAULT_HAIKU_MODEL" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "要恢复默认设置，请从 ~/.claude/settings.json 中移除以下环境变量：\n- ANTHROPIC_BASE_URL\n- ANTHROPIC_AUTH_TOKEN\n- ANTHROPIC_DEFAULT_OPUS_MODEL\n- ANTHROPIC_DEFAULT_SONNET_MODEL\n- ANTHROPIC_DEFAULT_HAIKU_MODEL" } } } },
    "agents.claude.saveSettings" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Option 1: Save as ~/.claude/settings.json" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Option 1 : enregistrer dans ~/.claude/settings.json" } }, "vi" : { "stringUnit" : { "state" : "translated", "value" : "Tùy chọn 1: Lưu vào ~/.claude/settings.json" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "选项 1：保存为 ~/.claude/settings.json" } } } },
    "agents.claude.settingsAndShellSaved" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Configuration saved to ~/.claude/settings.json and shell profile updated." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "La configuration a été enregistrée dans ~/.claude/settings.json et le profil shell a été mis à jour." } }, "vi" : { "stringUnit" : { "state" : "translated", "value" : "Đã lưu cấu hình vào ~/.claude/settings.json và cập nhật hồ sơ shell." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "配置已保存到 ~/.claude/settings.json，并已更新 Shell 配置文件。" } } } },
    "agents.claude.settingsSaved" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Configuration saved to ~/.claude/settings.json" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Configuration enregistrée dans ~/.claude/settings.json" } }, "vi" : { "stringUnit" : { "state" : "translated", "value" : "Đã lưu cấu hình vào ~/.claude/settings.json" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "配置已保存到 ~/.claude/settings.json" } } } },
    "agents.claude.shellExportsReady" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Shell exports ready. Add to your shell profile to complete setup." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Les variables shell exportées sont prêtes. Ajoutez-les à votre profil shell pour terminer la configuration." } }, "vi" : { "stringUnit" : { "state" : "translated", "value" : "Các biến shell export đã sẵn sàng. Thêm chúng vào hồ sơ shell để hoàn tất thiết lập." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "Shell 导出变量已准备就绪。请将其添加到 Shell 配置文件以完成设置。" } } } },
