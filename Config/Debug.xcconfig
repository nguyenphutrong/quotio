// Debug.xcconfig
// Base configuration for Debug builds
// This file is tracked by git

// Default Debug settings (will be overridden by Local.xcconfig if it exists)
PRODUCT_BUNDLE_IDENTIFIER = app.bytrong.quotio
PRODUCT_NAME = Quotio
INFOPLIST_KEY_CFBundleDisplayName = Quotio
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon
POSTHOG_PROJECT_TOKEN =
POSTHOG_HOST = https:/$()/us.i.posthog.com

// Include local overrides AFTER defaults (so Local.xcconfig can override)
// Local.xcconfig is gitignored and can contain developer-specific settings
#include? "Local.xcconfig"
